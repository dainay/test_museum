  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Les ann\xE9es 70\u201380 sont particuli\xE8rement actives :\n\r\n- 1976
    : mise en place du premier service d\u2019auxiliaires de vie \xE0 Bordeaux, permettant
    un accompagnement quotidien plus autonome\r\n- 1982 : manifestation nationale
    pour l\u2019acc\xE8s aux transports, rassemblant d\xE9j\xE0 plus de 5 000 personnes
    handicap\xE9es dans la rue\r\n- 1987 : premi\xE8re intervention d\u2019ergoth\xE9rapie
    \xE0 domicile\r\n- 1990 : ouverture du premier appartement d\u2019entra\xEEnement
    \xE0 la vie autonome dans le Var.\r\n\nEn 1987, la loi du 10 juillet impose l\u2019obligation
    d\u2019emploi des personnes handicap\xE9es dans le secteur ordinaire. L\u2019APF
    y joue un r\xF4le moteur, port\xE9e par l\u2019engagement fort de son pr\xE9sident
    Paul Boulinier et de son vice-pr\xE9sident Joseph Fricot, dont le travail de
    plaidoyer a profond\xE9ment marqu\xE9 cette p\xE9riode"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 603f9c33538968642a3abb523b88a91b, type: 2}
  m_sharedMaterial: {fileID: -2012617884002664389, guid: 603f9c33538968642a3abb523b88a91b,
