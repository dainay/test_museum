    - target: {fileID: 1854530405853092059, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Accordez-vous de l'importance au fait d'\xEAtre expos\xE9 ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1993532639999463557, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Qu'est ce que vous aimez dans l'art ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 2177593185769959870, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "\xC7a me vient comme \xE7a. Je ne cherche pas des heures \xE0... \xC7a
        vient ou \xE7a ne vient pas, quoi.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 2260937539689540916, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Avez-vous toujours \xE9t\xE9 passionn\xE9 de peinture ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 2387610332415337777, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: Olivier Kammerer
      objectReference: {fileID: 0}
