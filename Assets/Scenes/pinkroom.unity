  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Oui. Je trouve que c'est une bonne exp\xE9rience. C'est une bonne approche
    de voir que des gens s'int\xE9ressent \xE0 ce qu'on fait, quoi. Je n'oblige pas
    les gens \xE0 aimer ce que je fais, hein. D\xE9j\xE0, je pense que dans la peinture
    ou toute forme d'art, il faut d\xE9j\xE0 \xEAtre curieux.\r\nC'est l'amour de
    ce qu'on fait. Nous-m\xEAmes on apprend \xE0 se conna\xEEtre un peu plus."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
