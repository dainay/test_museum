  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "J\u2019aime les couleurs, j'aime l'imaginaire. J'aime la po\xE9sie de
    la cr\xE9ation. Pour moi, peindre ou \xE9crire, c'est deux choses similaires
    qui m'apportent de la po\xE9sie, de la s\xE9r\xE9nit\xE9, du calme. C'est ce
    que tout le monde devrait faire.\r\nDans la peinture comme dans tous les arts.
    On ne doit pas se laisser d\xE9courager par d'autres personnes qui vous disent
    \u201Cje comprends rien \xE0 ce que tu veux dire.\u201D Il faut avoir du recul,
    il faut aimer peindre, \xE9crire. Il faut \xEAtre imaginatif."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
