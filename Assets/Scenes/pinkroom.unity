      m_Calls: []
  m_text: "Jimi Hendrix\u2026 L\u2019album, c'est Band of Gypsys. Une bande de gypsies.
    C'est \xE7a qui m\u2019a le plus inspir\xE9. Et mon second artiste pr\xE9f\xE9r\xE9,
    c'est James Brown : sa fa\xE7on de chanter, de danser, ses paroles\u2026 Ce sont
    de grands artistes."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
