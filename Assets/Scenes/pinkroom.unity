    - target: {fileID: 1887186147799299058, guid: 55096ea30b05d4c979a851fb93321320,
        type: 3}
      propertyPath: m_text
      value: "\r3. Sans nom\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1887186147799299058, guid: 55096ea30b05d4c979a851fb93321320,
        type: 3}
      propertyPath: m_margin.w
      value: -30.110102
      objectReference: {fileID: 0}
    - target: {fileID: 2257119846061477080, guid: 55096ea30b05d4c979a851fb93321320,
        type: 3}
      propertyPath: m_text
      value: "Dans cette toile vive et intense, Abderhaman Bari laisse libre cours
        \xE0 son imaginaire. Les couleurs semblent jaillir de la surface : le bleu
        profond du bas \xE9voque une mer agit\xE9e ou un r\xEAve en mouvement, tandis
        que le rouge et l\u2019orange, en vagues incandescentes, rappellent la chaleur
        d\u2019un feu ou les battements d\u2019un c\u0153ur en pleine effusion.\n\nLe
        rose du ciel, parsem\xE9 de projections, donne \xE0 l\u2019ensemble une dimension
        presque cosmique, entre ciel et terre, entre calme et chaos.\nC\u2019est
        une peinture de sensations, de spontan\xE9it\xE9, de gestes amples et de
        libert\xE9 assum\xE9e. Elle ne cherche pas \xE0 repr\xE9senter, mais \xE0
        exprimer. Et c\u2019est dans cette \xE9nergie brute que r\xE9side toute sa
        force.\n\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2732891405849375154, guid: 55096ea30b05d4c979a851fb93321320,
        type: 3}
      propertyPath: m_Name
      value: Abderhaman Bari paint pinkroom
      objectReference: {fileID: 0}
    - target: {fileID: 2767651293913628857, guid: 55096ea30b05d4c979a851fb93321320,
        type: 3}
      propertyPath: m_Intensity
