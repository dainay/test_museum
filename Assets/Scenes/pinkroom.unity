  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "De toute fa\xE7on, l'imagination, comme tout art, je pense qu\u2019il
    suffit qu\u2019un jour, quelqu'un ne va pas aimer \xE7a et un jour, peut-\xEAtre,
    que cette personne se d\xE9couvrira au fil des ann\xE9es qui passent.\r\nIl y
    a la toile ou le papier, et apr\xE8s, il y a le stylo ou le pinceau, qui vous
    guide petit \xE0 petit."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
