  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "J\u2019esp\xE8re pour tous les gens du Maine, qui maintenant sont mes
    amis et quelque part ma famille, ma grande famille, que \xE7a va leur apporter
    de l\u2019attention, cette expo virtuelle. Et que \xE7a va les mettre en valeur,
    parce qu'ils le m\xE9ritent.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
