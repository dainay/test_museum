    - target: {fileID: 5150336306682347031, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Name
      value: LAYOUTPRefab (3)
      objectReference: {fileID: 0}
    - target: {fileID: 5990020983876644279, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: 8629bd684653c474d8d1dd29a0f9f467,
        type: 3}
    - target: {fileID: 6007956954738302995, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Pour B\xE9n\xE9dicte Layet, le jaune est une couleur forte, lumineuse,
        qui \xE9voque la paix, la joie, la lumi\xE8re, et la beaut\xE9 de la vie.
        Elle l\u2019utilise ici pour transmettre ces sentiments et inviter \xE0 la
        s\xE9r\xE9nit\xE9.\nElle ne cherche pas \xE0 repr\xE9senter quelque chose
        de pr\xE9cis. Elle peint de mani\xE8re instinctive, \xE0 l\u2019\xE9coute
        de ses \xE9motions.\nChaque \u0153uvre est une trace de ce qu\u2019elle ressent
        sur le moment. Elle ne donne pas de titre, pour ne pas influencer l\u2019interpr\xE9tation.
        Le regardeur est libre d\u2019y voir ce qu\u2019il veut, d\u2019y ressentir
        ce qui le touche.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6909928605911093964, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Materials.Array.data[0]
      value: 
      objectReference: {fileID: 2100000, guid: 8d3c7ec764e425e40b404a6c1b7e3185, type: 2}
