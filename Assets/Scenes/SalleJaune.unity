    - target: {fileID: 5150336306682347031, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Name
      value: LAYOUTPRefab (1)
      objectReference: {fileID: 0}
    - target: {fileID: 5990020983876644279, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: 9c6abdd7298374e95b39a539ea7683fa,
        type: 3}
    - target: {fileID: 6007956954738302995, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Dans ce tableau vibrant, Julie Capdevielle nous invite \xE0 plonger
        dans un monde o\xF9 la joie et la couleur s\u2019entrelacent. Avec une palette
        \xE9clatante, elle d\xE9ploie des fleurs aux teintes vives qui semblent \xE9clore
        sous nos yeux. Le jaune lumineux, omnipr\xE9sent, symbolise la chaleur, l\u2019\xE9nergie
        et l\u2019optimisme. Il fait \xE9cho \xE0 l\u2019instant pr\xE9sent, \xE0
        la beaut\xE9 de l\u2019\xE9panouissement.\n\nLes fleurs, qui se d\xE9ploient
        comme une explosion organique, capturent un moment fugace de la nature, une
        sorte de respiration universelle, pleine de l\xE9g\xE8ret\xE9 et de vitalit\xE9.
        L\u2019artiste, toujours \xE0 l\u2019aff\xFBt des tendances modernes, parvient
        \xE0 cr\xE9er une \u0153uvre dynamique et joyeuse qui interpelle autant qu\u2019elle
        enchante.\n\nJulie Capdevielle parvient \xE0 marier l\u2019abstraction et
        le figuratif dans un m\xEAme souffle, r\xE9inventant ainsi les formes et
        les couleurs dans un esprit de renouveau. Une \u0153uvre pleine de vie qui
        nous rappelle que la beaut\xE9 r\xE9side dans les moments simples, mais aussi
        dans les surprises qu\u2019elle nous r\xE9serve.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6909928605911093964, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Materials.Array.data[0]
      value: 
      objectReference: {fileID: 2100000, guid: 8d3c7ec764e425e40b404a6c1b7e3185, type: 2}
    - target: {fileID: 7203696373511224816, guid: 518dafb9ccee39747a410d95cb36e6f5,
