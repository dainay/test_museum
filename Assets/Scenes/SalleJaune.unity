      propertyPath: m_Materials.Array.data[0]
      value: 
      objectReference: {fileID: 2100000, guid: 33a7d62e1b0c4420682a007db9d8dfe1, type: 2}
    - target: {fileID: 4916180120825023323, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_margin.w
      value: -125.282776
      objectReference: {fileID: 0}
    - target: {fileID: 5150336306682347031, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Name
      value: LAYOUTPRefab (2)
      objectReference: {fileID: 0}
    - target: {fileID: 6007956954738302995, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Avec cette \u0153uvre lumineuse, Yves Bourdon nous invite \xE0 une
        promenade sensorielle au c\u0153ur d\u2019un paysage imaginaire. Des arabesques
        l\xE9g\xE8res, des touches \xE9clatantes de jaune, de bleu et d\u2019orang\xE9
        se m\xEAlent pour \xE9voquer un jardin travers\xE9 par la lumi\xE8re, caress\xE9
        par le vent.\r\n\nOn devine la silhouette d\u2019un pont, des arbres aux
        feuillages dansants, et cette impression de transparence qui donne \xE0 la
        sc\xE8ne un souffle presque musical. Le geste est fluide, le graphisme d\xE9licat,
        comme une \xE9criture silencieuse de la nature en mouvement.\n\r\nChaque
        couleur semble vibrer au rythme d\u2019un instant suspendu. Yves capte l\u2019\xE9ph\xE9m\xE8re,
        la po\xE9sie de la lumi\xE8re filtrant entre les branches, le murmure de
        l\u2019air sur l\u2019eau. C\u2019est une peinture qui respire, qui apaise,
        et qui c\xE9l\xE8bre la beaut\xE9 discr\xE8te des choses simples.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6007956954738302995, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_margin.w
      value: -333.987
      objectReference: {fileID: 0}
