      objectReference: {fileID: 2100000, guid: b9c14d12c428a490dbf169eda00710a2, type: 2}
    - target: {fileID: 4916180120825023323, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Paysages g\xE9ologiques, s\xE9dimentations po\xE9tiques.."
      objectReference: {fileID: 0}
    - target: {fileID: 5150336306682347031, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Name
      value: LAYOUTPRefab
      objectReference: {fileID: 0}
    - target: {fileID: 6007956954738302995, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Allong\xE9 sur le c\xF4t\xE9, Eric travaillait lentement, avec patience
        et pr\xE9cision, malgr\xE9 les contraintes impos\xE9es par la maladie. Incapable
        de se mouvoir librement, il peignait par strates, couche apr\xE8s couche,
        en demandant parfois qu\u2019on retourne la toile pour poursuivre le motif.\n\nL\u2019\u0153uvre
        superpose l\u2019acrylique et le papier de soie froiss\xE9. Ce papier, pos\xE9
        avec d\xE9licatesse, cr\xE9e des variations de texture et de lumi\xE8re,
        jouant avec la transparence.\n \nEn haut \xE0 gauche, un triangle vert clair
        surgit comme une \xE9l\xE9vation v\xE9g\xE9tale, tandis que le jaune \xE9clabouss\xE9
        trace un chemin de lumi\xE8re vers une zone plus chaude, plus dense, en bas
        \xE0 droite. Les textures et couleurs se d\xE9posent comme des couches de
        terre, de souvenirs ou de sensations, \xE9voquant une lente transformation
        du paysage int\xE9rieur.\n\nCe tableau, \xE0 la fois min\xE9ral et sensible,
        g\xE9ologique et intime, raconte une travers\xE9e immobile o\xF9 chaque s\xE9dimentation
        devient un acte de cr\xE9ation po\xE9tique. Malgr\xE9 l\u2019immobilit\xE9
        du corps, l\u2019\u0153uvre est en mouvement \u2013 un paysage int\xE9rieur,
        stratifi\xE9, vibrant.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6909928605911093964, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Materials.Array.data[0]
      value: 
      objectReference: {fileID: 2100000, guid: 8d3c7ec764e425e40b404a6c1b7e3185, type: 2}
    - target: {fileID: 7203696373511224816, guid: 518dafb9ccee39747a410d95cb36e6f5,
