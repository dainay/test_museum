        type: 3}
      propertyPath: m_Name
      value: LAYOUTPRefab Yves
      objectReference: {fileID: 0}
    - target: {fileID: 1174088851659602526, guid: 3389f5cc635d30141a2ecc16c28b8793,
        type: 3}
