--- !u!1001 &1926695095
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1036995648}
    m_Modifications:
    - target: {fileID: 822658543169537128, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Tout, tout m'int\xE9resse. Rien que la toile, m\xEAme nue, m'int\xE9resse.
        Tous les travaux manuels m'int\xE9ressent. Je fais du dessin, je fais du
        tricot, de la broderie. C\u2019est tout, je crois."
      objectReference: {fileID: 0}
    - target: {fileID: 942365216512111790, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Texture
