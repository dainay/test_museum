      objectReference: {fileID: 32900000, guid: a67b2062ec73c45bda51bc32af177a90,
        type: 3}
    - target: {fileID: 2115209045886748577, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -558
      objectReference: {fileID: 0}
    - target: {fileID: 2360951950092959751, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_Name
      value: LAYOUTPRefab Variant
      objectReference: {fileID: 0}
    - target: {fileID: 2938750398105273247, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_text
      value: "Je partage mon temps entre quatre activit\xE9s : \nle sport, r\xE9parer
        mes jambes, \nla musique, jouer du piano et chanter, \nles po\xE8mes, j\u2019ai
        \xE9cris plus de 900 po\xE8mes depuis six ans\net le dessin et la peinture.\nL\u2019inspiration
        elle vient d\u2019une personne que j\u2019aime plus que tout. Ce sont surtout
        des po\xE8mes d\u2019amour.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2938750398105273247, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_margin.w
