    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 822658543169537128, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "La musique, j\u2019aime beaucoup la musique classique. Un petit peu
        le slam, parce que je trouve que\r c\u2019est aussi une forme po\xE9tique
        qui rappelle un peu les psalmodies. Sinon, je suis plut\xF4t musiques\r XVIe
        et XVIIe.\n\nEt vous ne pratiquez pas ?\n\nNon, et j\u2019ai du mal \xE0
        chanter. M\xEAme si \xE7a m\u2019arrive au karaok\xE9, mais comme j\u2019ai
        perdu ma voix, j\u2019ai\r\nd\xFB mal \xE0 chanter.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 942365216512111790, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_Texture
