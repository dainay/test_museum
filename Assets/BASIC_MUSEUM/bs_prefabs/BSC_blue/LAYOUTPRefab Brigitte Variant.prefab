    - target: {fileID: 822658543169537128, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Tout, tout m'int\xE9resse. Rien que la toile, m\xEAme nue, m'int\xE9resse.
        Tous les travaux manuels m'int\xE9ressent. Je fais du dessin, je fais du
        tricot, de la broderie. C\u2019est tout, je crois."
      objectReference: {fileID: 0}
