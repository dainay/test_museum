    - target: {fileID: 4052466807415116894, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: Quels outils utilisez-vous ?
      objectReference: {fileID: 0}
    - target: {fileID: 4415194889633676988, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_LocalPosition.z
      value: -0
      objectReference: {fileID: 0}
