  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mme Semon voue une grande admiration aux artistes de la Renaissance tels
    que Michel-Ange, Sandro Botticelli, Fra Angelico ou encore Frans Hals.\n\n\xC0
    la Renaissance, le vert \xE9tait une couleur ambivalente : symbole de nature
    et de fertilit\xE9, mais aussi parfois per\xE7ue comme maudite et toxique en
    raison des pigments utilis\xE9s \xE0 sa conception. Catherine Semon se r\xE9approprie
    aujourd\u2019hui cette teinte pour en faire un embl\xE8me d\u2019espoir.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 603f9c33538968642a3abb523b88a91b, type: 2}
  m_sharedMaterial: {fileID: -2012617884002664389, guid: 603f9c33538968642a3abb523b88a91b,
    type: 2}
