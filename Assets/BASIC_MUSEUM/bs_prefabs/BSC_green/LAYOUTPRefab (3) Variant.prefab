    - target: {fileID: 8135019395422015076, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "D\xE9crivez l'art d'Alexandra en 3 mots.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8283876646048440358, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Quel message Alexandra veut-elle faire passer dans ses peintures ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8387012195628576533, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_StaticEditorFlags
      value: 2147483647
      objectReference: {fileID: 0}
    - target: {fileID: 8406059711226971643, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Elle a fait pas mal d'expos dans le quartier. Et puis, j'ai jamais,
        jamais voulu vendre ses tableaux. Elle avait fait une expo au Trocad\xE9ro.
        Elle a fait deux fois au S\xE9nat, donc, avec Jo\xEBlle.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8478252201501981397, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_StaticEditorFlags
      value: 2147483647
      objectReference: {fileID: 0}
