  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Parce que je suis fi\xE8re de ma fille, d\u2019abord. Enfin, toute la
    famille. Et pour elle aussi quoi. Tout est pour ma fille dans ma vie aujourd'hui,
    vous savez. Ma fille, sa s\u0153ur et ma petite-fille."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
