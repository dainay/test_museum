    - target: {fileID: 1854530405853092059, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Est-ce important d'\xEAtre expos\xE9e ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1878525996327428254, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_StaticEditorFlags
      value: 2147483647
      objectReference: {fileID: 0}
    - target: {fileID: 1993532639999463557, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Quel.le.s artistes l'inspire ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 2177593185769959870, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Tu es un peu... herm\xE9tique. Je suis herm\xE9tique. Oui, si vous
        voulez. Je ne vois pas l'art comme elle. Vous voyez ce que je veux dire.
        Donc, moi, je suis heureuse de voir ce qu'elle fait. Elle, dans sa t\xEAte,
        \xE7a a s\xFBrement beaucoup plus de signification que pour moi. Vous voyez
        ? C'est son domaine quoi. Voil\xE0. Elle s'exprime. C'est comme \xE7a qu'elle
        s'exprime en fait."
      objectReference: {fileID: 0}
    - target: {fileID: 2260937539689540916, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Comment Alexandra a-t-elle d\xE9but\xE9 la peinture ?\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2267870280521584814, guid: 518dafb9ccee39747a410d95cb36e6f5,
