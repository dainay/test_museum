      value: 1022.525
      objectReference: {fileID: 0}
    - target: {fileID: 2803842975821069091, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -172.08499
      objectReference: {fileID: 0}
    - target: {fileID: 2875896031646799286, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_StaticEditorFlags
      value: 2147483647
      objectReference: {fileID: 0}
    - target: {fileID: 2924477085394041953, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Non, des retours, non. Je vous le disais tout \xE0 l'heure, c'est qu\u2019au
        cours de certaines expos, j'\xE9coutais les gens autour. Et \xE7a, j'ai trouv\xE9
        \xE7a tr\xE8s touchant parce que les gens \xE9taient intrigu\xE9s. Ils passaient
        pas comme \xE7a en disant : \u201CC'est quoi, c'est quoi ?\u201D Non.\r\n\xC7a
        interpelle les gens ? Oui, \xE7a interpelle les gens."
      objectReference: {fileID: 0}
    - target: {fileID: 3087550307152647090, guid: 518dafb9ccee39747a410d95cb36e6f5,
