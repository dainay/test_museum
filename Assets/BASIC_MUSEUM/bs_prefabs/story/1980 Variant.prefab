    - target: {fileID: 6982605431513193509, guid: 1d17ff5495c8eb642a0f3770a543d555,
        type: 3}
      propertyPath: m_text
      value: " L\u2019APF devient un acteur incontournable dans la d\xE9fense des
        droits des personnes en situation de handicap. Elle intensifie ses actions
        pour l'accessibilit\xE9, l'\xE9ducation et l'emploi, \r\ncontribuant \xE0
        faire \xE9voluer les mentalit\xE9s et les politiques publiques.\r\n\n\xC0
        partir du Congr\xE8s de 1966, l\u2019APF adopte une nouvelle posture militante
        : le mot \xAB Revendications \xBB  remplace celui de \xAB v\u0153ux \xBB,
        marquant un tournant d\xE9cisif dans son engagement politique.\r\n"
      objectReference: {fileID: 0}
