  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u201CCe sont ses adh\xE9rents qui fondent la l\xE9gitimit\xE9 de l\u2019APF
    en tant qu\u2019association de personnes handicap\xE9es. Ils y tiennent donc
    une place pr\xE9pond\xE9rante et s'expriment, donnent leir avis, sont consult\xE9s,
    votent les orientations. L\u2019APF prend toute disposition pour continuer \xE0
    assurer le fonctionnement d\xE9mocratique non seulement de l\u2019assembl\xE9e
    g\xE9n\xE9rale mais, en premier lieu des assembl\xE9es d\xE9partementales qui
    se tiennent annuellement. Au cours de ces assembl\xE9es, des adh\xE9rents sont
    \xE9lus pour repr\xE9senter leurs pairs dans l\u2019\xE9quipe d\xE9partementale.\n\n
    L\u2019APF s\u2019assure de leur participation dans les groupes ponctuels ou
    permanents, qui traitent directement de la vie des personnes handicap\xE9es ou
    de leur famille dans le d\xE9partement, la r\xE9gion ou la nation. Elle cherche
    \xE9galement \xE0 favoriser leur participation aux commissions ou au conseil
    d\u2019administration d\u2019organismes traitant de leurs probl\xE8mes.\u201D
    \n\n\xAB Ensemble, Agir \xBB (extrait)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 603f9c33538968642a3abb523b88a91b, type: 2}
