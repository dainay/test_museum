      propertyPath: m_AnchoredPosition.y
      value: -2750.445
      objectReference: {fileID: 0}
    - target: {fileID: 8633618923285260120, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Je suis tr\xE8s instinctif. Le violet, le rose, c'est des couleurs
        que j'aime. Je fais par rapport \xE0 ce que j'ai sur ma palette. Je marche
        comme \xE7a, quoi. Je laisse beaucoup de blanc, maintenant. Avant, il fallait
        que je peigne tout. Et maintenant, avec Sophie, j'ai appris \xE0 d\xE9couvrir
        qu'une toile, ce n'\xE9tait pas sp\xE9cialement peindre toute la toile.\r\nTout
        d\xE9pend des go\xFBts des uns et des autres. Je prends beaucoup de conseils
        par rapport \xE0 Sophie. J'\xE9coute beaucoup ce que mes coll\xE8gues pensent
        et \xE7a m'inspire aussi."
      objectReference: {fileID: 0}
    - target: {fileID: 8635853546772337790, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "L'art a-t-il une place importante dans votre vie ?\r"
      objectReference: {fileID: 0}
