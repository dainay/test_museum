  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Premi\xE8rement : la curiosit\xE9 et la passion, l'envie de se d\xE9couvrir
    autrement et d'essayer de se lancer, quoi. Ne pas avoir peur des remontrances,
    des retours n\xE9gatifs. Quand on d\xE9bute quelque chose, il faut accepter le
    c\xF4t\xE9 positif et aussi le c\xF4t\xE9 n\xE9gatif. Lancez-vous, quoi ! Il
    faut se lancer.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
