    - target: {fileID: 822658543169537128, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "J'adore Frida Kahlo. Je suis tomb\xE9 amoureux de son art. Il y a des
        gens comme \xE7a qui donnent envie de refaire la m\xEAme chose, ou d\xE9j\xE0
        de vouloir cr\xE9er."
      objectReference: {fileID: 0}
