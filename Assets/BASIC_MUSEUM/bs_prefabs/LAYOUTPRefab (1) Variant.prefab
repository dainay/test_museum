  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Oui, s\u2019il y en a qui ont envie d\u2019\xE9couter. Je n\u2019attends
    rien en fait. Je suis d\xE9j\xE0 tellement heureux d\u2019\xEAtre revenu dans
    le monde des vivants et de pouvoir m\u2019exprimer et cr\xE9er, peu importe si
    c'est des dessins, des po\xE8mes, des chansons, des morceaux de piano... que
    je ne demande rien de plus. C\u2019est que du bonus pour moi.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
