    - target: {fileID: 8135019395422015076, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Quelle est l'histoire derri\xE8re vote peinture ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8283876646048440358, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Quel est votre rapport \xE0 la couleur ?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8406059711226971643, guid: 518dafb9ccee39747a410d95cb36e6f5,
        type: 3}
      propertyPath: m_text
      value: "Oui, avec les \xE9motions, l\u2019instinct. Je suis d'accord avec \xE7a.
        C\u2019est un peu ma fa\xE7on de travailler, en tout cas pour moi. Et j\u2019ai
        l\u2019impression qu'on retrouve \xE7a beaucoup parmi les tableaux que vous
        choisissez.\r"
      objectReference: {fileID: 0}
