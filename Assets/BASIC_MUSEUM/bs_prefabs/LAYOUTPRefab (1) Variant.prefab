--- !u!114 &7064177922011533739
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5562626394338763599}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Oui. Tout \xE0 fait. Ces personnes m\xE9ritent de l\u2019attention, et
    quand on va tr\xE8s bien et qu'on d\xE9cide de faire une b\xEAtise telle que
    celle que j\u2019ai faite, on oublie tout ce qu'on a acquis depuis l\u2019enfance
    : apprendre \xE0 marcher, \xE0 \xE9crire, \xE0 parler. Et quand on est face \xE0
    des personnes, dont je fais partie, on se rend compte que tout \xE7a peut \xEAtre
    retir\xE9 du jour au lendemain et donc il faut appr\xE9cier le peu, ou le beaucoup,
    qu'on a.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
