  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tout, en fait, l\u2019ensemble de ma vie. Comment j\u2019ai chut\xE9 d'ann\xE9es
    en ann\xE9es jusqu\u2019\xE0 tomber au plus bas. Comment j\u2019ai pu me relever.
    \xC0 quel point ma famille et mes amis m\u2019ont pardonn\xE9, moi qui ai voulu
    les quitter \xE0 l\u2019\xE2ge de 34 ans. Prions pour qu'on vive dans un monde
    libre et que sur Terre les guerres s\u2019arr\xEAtent, c'est le plus important.
    Qu'on atteigne enfin sur Terre la paix universelle. Des artistes comme John Coltrane,
    comme Duke Ellington, Thelonious Monk, des artistes de jazz en ont parl\xE9."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
