  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Je commence toujours au d\xE9but par de l\u2019art abstrait. C'est-\xE0-dire,
    je prends mon pinceau, et puis... Gr\xE2ce \xE0 l'animatrice Sophie, je me suis
    petit \xE0 petit mis au portrait et je me d\xE9couvre de jour en jour.\r\nJ\u2019apprends
    beaucoup la patience aussi, parce que je pense que dans le dessin, dans la peinture,
    c'est une histoire de patience. Avant, j'avais envie de terminer mon tableau
    le jour m\xEAme, quoi. Et maintenant, j'apprends \xE0 \xEAtre plus calme.\r\nMaintenant,
    j'ai un petit carnet o\xF9 je fais des croquis pour me donner des id\xE9es sur
    une prochaine peinture."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
