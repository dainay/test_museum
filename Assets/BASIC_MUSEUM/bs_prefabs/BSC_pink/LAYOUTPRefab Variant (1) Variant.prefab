      value: 
      objectReference: {fileID: 32900000, guid: 023359868fe61491abe334b78f71280a,
        type: 3}
    - target: {fileID: 2115209045886748577, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -121
      objectReference: {fileID: 0}
    - target: {fileID: 2360951950092959751, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_Name
      value: LAYOUTPRefab Variant (1) Variant
      objectReference: {fileID: 0}
    - target: {fileID: 2938750398105273247, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_text
      value: "Je commence toujours au d\xE9but par de l\u2019art abstrait. C'est-\xE0-dire,
        je prends mon pinceau, et puis... Je me suis petit \xE0 petit mis au portrait
        et je me d\xE9couvre de jour en jour.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 3481101328798382348, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_LocalPosition.z
      value: -0
      objectReference: {fileID: 0}
    - target: {fileID: 3481101328798382348, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: -4
      objectReference: {fileID: 0}
    - target: {fileID: 3481101328798382348, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -216
      objectReference: {fileID: 0}
    - target: {fileID: 3808620161684217347, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_text
      value: "Sous une pluie de formes et de couleurs, une maison \xE9merge, comme
        un souvenir qui flotte entre r\xEAve et r\xE9alit\xE9. Olivier Kammerer commence
        toujours ses toiles par un fond abstrait, riche en textures et en couleurs,
        r\xE9alis\xE9 de mani\xE8re spontan\xE9e. Une fois cette base pos\xE9e, il
        vient y ajouter un \xE9l\xE9ment figuratif, souvent simple mais fort, comme
        ici cette maison, qui se d\xE9tache du fond.\nDomin\xE9e par des teintes
        roses et violettes, cette \u0153uvre respire la joie et l\u2019imaginaire.
        Le violet et le rose, que M. Kammerer affectionne tout particuli\xE8rement,
        apportent \xE0 la sc\xE8ne une douceur vibrante, presque magique. \nCette
        peinture est \xE0 d\xE9couvrir lentement, au rythme du regard, de l\u2019humeur,
        de l\u2019instant. Olivier Kammerer y affirme son go\xFBt pour la cr\xE9ation
        libre, l\u2019amour des couleurs et la po\xE9sie du geste.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4662232024424693967, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_SizeDelta.y
      value: 234
      objectReference: {fileID: 0}
    - target: {fileID: 4662232024424693967, guid: c1e76a28bc3f64e688d85df3fd69e118,
        type: 3}
      propertyPath: m_AnchoredPosition.y
