  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bah, d\xE9j\xE0 parce que vous me l'avez propos\xE9. Je trouve \xE7a int\xE9ressant
    pour \xE9clairer les gens qui s'int\xE9ressent \xE0 ma peinture et \xE0 la peinture
    ou \xE0 la cr\xE9ation en g\xE9n\xE9ral.\r\nParce que toute personne, m\xEAme
    se croyant non cr\xE9ative, non imaginative... Un jour ou l\u2019autre, on peut
    le devenir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
