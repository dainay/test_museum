--- !u!114 &8374504023541477224
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 773267920344983523}
  m_Enabled: 1
  m_EditorHideFlags: 0
