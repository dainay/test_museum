  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Je suis tr\xE8s instinctif. Le violet, le rose, c'est des couleurs que
    j'aime. Je fais par rapport \xE0 ce que j'ai sur ma palette. Je marche comme
    \xE7a, quoi. Je laisse beaucoup de blanc, maintenant. Avant, il fallait que je
    peigne tout. Et maintenant, avec Sophie, j'ai appris \xE0 d\xE9couvrir qu'une
    toile, ce n'\xE9tait pas sp\xE9cialement peindre toute la toile.\r\nTout d\xE9pend
    des go\xFBts des uns et des autres. Je prends beaucoup de conseils par rapport
    \xE0 Sophie. J'\xE9coute beaucoup ce que mes coll\xE8gues pensent et \xE7a m'inspire
    aussi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
