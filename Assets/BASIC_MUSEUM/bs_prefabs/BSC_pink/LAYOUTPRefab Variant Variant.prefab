  m_text: "J\u2019\xE9cris souvent le soir en \xE9coutant de la musique. \xC7a peut
    \xEAtre de la soul, du funk, du jazz ou du rap. J\u2019adore le rap, \xE0 la
    fois fran\xE7ais et am\xE9ricain.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
