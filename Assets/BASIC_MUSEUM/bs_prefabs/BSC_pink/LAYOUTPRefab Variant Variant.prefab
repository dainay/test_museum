  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jouer du piano. C\u2019\xE9tait un signe du destin que je tombe de cinq
    \xE9tages et que je me fracasse les pieds et les jambes en mille morceaux. Et
    que je ne puisse plus faire de batterie, que je recommence tout \xE0 z\xE9ro.
    Et par chance, mes mains et mes bras sont en bon \xE9tat, et donc je peux jouer
    du piano sans probl\xE8me. Le destin a fait que mon instrument, c'est le piano."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
