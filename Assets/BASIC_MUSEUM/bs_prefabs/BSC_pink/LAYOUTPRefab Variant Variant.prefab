  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "J\u2019\xE9tais immobilis\xE9 sur un lit d\u2019h\xF4pital. Et j'avais
    enregistr\xE9 des musiques avant mon accident, des morceaux instrumentaux. Et
    donc je me suis dit : \"Tiens, je vais me mettre \xE0 chanter et \xE0 \xE9crire
    des paroles.\" Donc j\u2019ai \xE9crit une quarantaine de chansons correspondant
    \xE0 la musique. Et apr\xE8s, quand la musique \xE9tait utilis\xE9e, j'avais
    encore envie d\u2019\xE9crire, donc c\u2019est devenu des po\xE8mes.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
