  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Je partage mon temps entre quatre activit\xE9s : le 1, c\u2019est le sport,
    r\xE9parer mes jambes. Le 2, c\u2019est la musique, jouer du piano et chanter.
    Le 3, c'est les po\xE8mes. J\u2019ai \xE9crit un peu plus de 900 po\xE8mes depuis
    six ans. Et le 4, c'est le dessin et la peinture."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
