--- !u!114 &6424857313819015596
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 595585790264254375}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "J\u2019ai une famille de peintres. Mon grand-p\xE8re \xE9tait polonais
    et il \xE9tait peintre. Ma m\xE8re, sa fille, est peintre. Elle a un atelier,
    et mon petit fr\xE8re reprend les cours de l\u2019atelier. Donc c\u2019est trois
    g\xE9n\xE9rations qui font de la peinture, du dessin, des arts plastiques. Donc
    moi j\u2019ai, je ne sais pas si on peut appeler \xE7a facilit\xE9, mais \xE7a
    ne me pose pas de probl\xE8me de faire un dessin comme celui que vous avez choisi.
    C'est assez facile pour moi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
