  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Peinte \xE0 la R\xE9sidence du Maine, cette toile est l\u2019expression
    brute des \xE9motions d\u2019Alexandra Mayolle. \r\nLes couleurs s\u2019y m\xEAlent
    en un ensemble harmonieux et contrast\xE9. Des nuances de bleu d\xE9corent les
    coins en haut \xE0 gauche et en bas \xE0 droite de la toile, tandis que les deux
    autres coins oppos\xE9s sont peints de diff\xE9rentes teintes de jaune. Au centre,
    le rouge et le violet se d\xE9tachent sur un fond vert, marron et blanc. De fins
    fils noirs segmentent les couleurs, cr\xE9ant une atmosph\xE8re \xE0 la fois
    compl\xE8te et complexe.\r\nAlexandra, de sa main gauche, retranscrit ainsi son
    monde sur une toile color\xE9e et abstraite aux tons vari\xE9s. Pour elle, la
    peinture est une forme d\u2019expression honn\xEAte et transparente, o\xF9 chaque
    \xE9motion se transforme en un nuancier diversifi\xE9. \r\n\r\n\u201CL\u2019art
    d\u2019Alexandra est un m\xE9lange entre couleur et \xE9nigme.\u201D - Denise
    Latour Daudin Mayolle, m\xE8re de l\u2019artiste\r\n\r\nApr\xE8s un accident,
    Alexandra Mayolle, droiti\xE8re, a \xE9t\xE9 contrainte de peindre de la main
    gauche.\r\n\r\nSon art a connu de nombreuses \xE9volutions : apr\xE8s avoir commenc\xE9
    par dessiner des portraits et des sujets figuratifs, elle se consacre aujourd\u2019hui
    \xE0 la peinture abstraite.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 603f9c33538968642a3abb523b88a91b, type: 2}
  m_sharedMaterial: {fileID: -2012617884002664389, guid: 603f9c33538968642a3abb523b88a91b,
