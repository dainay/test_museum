--- !u!114 &1919471509594125564
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5919415511071944385}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jean-Daniel, r\xE9sident en situation de handicap, a r\xE9alis\xE9 ce
    grand vitrail en collaboration avec les ateliers Loir de Chartres. Ce projet
    est n\xE9 d\u2019une exposition organis\xE9e au sein de la r\xE9sidence Jacques
    Bourgarel, o\xF9 l\u2019art vient \xE0 la rencontre des habitants.\r\nPendant
    un an, Jean-Daniel a agenc\xE9 patiemment des dalles de verre color\xE9 pour
    cr\xE9er un chemin lumineux, guid\xE9 par le jaune du soleil et entour\xE9 de
    bleu, vert et rouge. Chaque couleur symbolise une \xE9motion, un passage, un
    r\xEAve. Le bleu rappelle les vitraux de Chartres, tandis que le jaune \xE9voque
    un voyage vers l\u2019ailleurs.\r\nGr\xE2ce \xE0 ce travail, Jean-Daniel a pu
    s\u2019apaiser, se concentrer et se d\xE9passer. Les ateliers Loir de Chartres
    ont finalis\xE9 l\u2019\u0153uvre en coulant la r\xE9sine noire, soudant ainsi
    le verre color\xE9 charg\xE9 d\u2019\xE9motions. Ce vitrail est l\u2019aboutissement
    d\u2019un projet personnel et artistique fort, symbole de transformation et de
    reconnaissance.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 603f9c33538968642a3abb523b88a91b, type: 2}
  m_sharedMaterial: {fileID: -2012617884002664389, guid: 603f9c33538968642a3abb523b88a91b,
    type: 2}
