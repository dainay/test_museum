    - target: {fileID: 4423029522701104781, guid: b97205010b441a54099ca1bcd248a9c7,
        type: 3}
      propertyPath: m_Name
      value: YEAR PERFAB
      objectReference: {fileID: 0}
    - target: {fileID: 5155588237091283832, guid: b97205010b441a54099ca1bcd248a9c7,
        type: 3}
      propertyPath: m_text
      value: "En 1933, quatre jeunes atteints de poliomy\xE9lite ; Andr\xE9 Trannoy,
        Jacques Dubuisson, Jeanne Henry et Clothilde Lamborot ; fondent l'Association
        des Paralys\xE9s et Rhumatisants, future APF France handicap. Leur objectif
        : rompre l'isolement des personnes en situation de handicap et cr\xE9er un
        r\xE9seau d'entraide. D\xE8s 1939, l'association ouvre son premier foyer
        pour \xAB grands invalides sans famille \xBB, marquant le d\xE9but d'une
        action concr\xE8te sur le terrain."
      objectReference: {fileID: 0}
